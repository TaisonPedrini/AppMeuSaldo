{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "README.md",
      "CLAUDE.md",
      "**/.*",
      "**/.*/**",
      ".git/**",
      ".claude/**",
      "design/**",
      ".firebase/**",
      "package.json",
      "**/node_modules/**"
    ],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  }
}
